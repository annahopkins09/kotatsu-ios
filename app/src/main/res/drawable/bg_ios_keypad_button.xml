<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
	android:color="@color/ios_keypad_button_ripple">
	<item android:id="@android:id/mask">
		<shape android:shape="oval">
			<solid android:color="#FFFFFF" />
		</shape>
	</item>
	<item>
		<selector>
			<item android:state_pressed="true">
				<shape android:shape="oval">
					<solid android:color="@color/ios_keypad_button_bg_pressed" />
				</shape>
			</item>
			<item>
				<shape android:shape="oval">
					<solid android:color="@color/ios_keypad_button_bg" />
					<stroke
						android:width="0.5dp"
						android:color="@color/ios_border_subtle" />
				</shape>
			</item>
		</selector>
	</item>
</ripple>
